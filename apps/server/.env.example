# Copy this file to `.env.development` (dev) or `.env.production` (prod) and
# fill in real values — don't share a single `.env` file across environments.
# Do not commit the real `.env*` files (already in .gitignore).
#
# These are Cloudflare Worker bindings, loaded via
# packages/infra/alchemy.run.ts (dotenv, based on NODE_ENV) and passed into
# the Worker through `bindings` — there's no zod-validated schema like
# apps/api in turborepo-template, so a missing var only surfaces at runtime
# when a handler reads it (see src/index.ts).

# ─────────────────────────── App ───────────────────────────
# [REQUIRED] Origin allowed to call CORS (hono/cors, origin), applied to all
# routes (see src/index.ts). apps/extension calls /api/auth/* from an
# extension page (background/popup), whose origin is
# chrome-extension://<extension-id> — NOT a localhost URL. That request
# already bypasses this check in Chrome because apps/extension declares
# host_permissions: ["<all_urls>"] (see wxt.config.ts), so this value mainly
# matters for browser clients other than the extension itself (e.g. hitting
# the API directly from a local web page during development). Accepts a
# single origin only (not a comma-separated list).
CORS_ORIGIN="chrome-extension://<your-extension-id>"

# ─────────────────────────── Google OAuth ───────────────────────────
# [REQUIRED] Google OAuth Client ID/Secret ("Web application" type), used to
# exchange an authorization code for access/refresh tokens and to refresh
# the token once expired (see src/index.ts, POST /api/auth/token and
# /api/auth/refresh). Client ID must match WXT_GOOGLE_CLIENT_ID on
# apps/extension.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [REQUIRED] Default redirect URI used when a request doesn't send its own
# redirectUri (see src/index.ts, fallback c.env.GOOGLE_REDIRECT_URI). Must
# match the redirect URI registered on Google Cloud Console.
GOOGLE_REDIRECT_URI=
