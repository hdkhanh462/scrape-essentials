# Copy this file to `.env` and fill in real values: cp .env.example .env
# Do not commit `.env` (already in .gitignore).
#
# Read via import.meta.env at build/dev time (Vite). WXT only exposes client
# vars prefixed VITE_ or WXT_ — anything else stays undefined.

# ─────────────────────────── Backend ───────────────────────────
# [REQUIRED] Base URL of apps/server (see src/features/backup/utils.ts,
# apiUrl) — used to exchange/refresh the Google OAuth token for the backup
# feature. When running apps/server locally via alchemy dev, the default
# port is 3000.
VITE_API_URL=http://localhost:3000

# ─────────────────────────── Google OAuth ───────────────────────────
# [REQUIRED] Google OAuth Client ID ("Web application" type), used
# client-side to open the consent screen via
# browser.identity.launchWebAuthFlow (see src/features/backup/identity.ts,
# launchWebAuthFlow). Must match GOOGLE_CLIENT_ID on apps/server
# (client_secret only lives on the server).
# The redirect URI registered on Google Cloud Console must match
# browser.identity.getRedirectURL() of the loaded extension.
WXT_GOOGLE_CLIENT_ID=
